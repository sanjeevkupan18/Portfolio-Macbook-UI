{
  "name": "sanjeev-mac-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive macOS-style developer portfolio for Sanjeev Kumar Pandit (Next.js, TypeScript, MongoDB)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:deployment": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-deployment.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local database/migrate.mjs",
    "admin:hash": "node scripts/hash-password.mjs",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "mongodb": "^7.7.0",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.8",
    "simple-icons": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
